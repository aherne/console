<view>
    <h2>Balances</h2>
    <table border="rounded" width="72">
        <column width="34"/>
        <column width="16"/>
        <column/>
        <thead>
            <tr>
                <th>Account</th>
                <th align="right">Balance</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Primary operating account</td>
                <td align="right">1250.00</td>
